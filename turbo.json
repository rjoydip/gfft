{
  "$schema": "https://turborepo.org/schema.json",
  "baseBranch": "origin/main",
  "pipeline": {
    "dev": {
      "dependsOn": ["^dev", "^build"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "@gfft/ui#build:storybook"],
      "outputs": ["dist/**", "storybook-static/**"],
      "outputMode": "new-only"
    },
    "test": {
      "dependsOn": ["^build", "test:ci", "test:cli", "@gfft/ui#test:storybook"]
    },
    "test:cli": {
      "dependsOn": ["@gfft/core#build", "@gfft/utils#build"],
      "cache": false
    },
    "test:ci": {},
    "build:storybook": {
      "cache": false
    },
    "test:storybook": {
      "cache": false
    }
  }
}
