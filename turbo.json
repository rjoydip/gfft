{
  "$schema": "https://turborepo.org/schema.json",
  "baseBranch": "origin/main",
  "pipeline": {
    "dev": {
      "dependsOn": ["^dev", "^build"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "@gfft/ui#build:storybook"],
      "outputs": ["dist/**"],
      "outputMode": "new-only"
    },
    "test": {
      "dependsOn": [
        "build",
        "test:ci",
        "@gfft/cli#test:cli",
        "@gfft/ui#test:storybook"
      ]
    },
    "test:ci": {}
  }
}
