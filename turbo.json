{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "pipeline": {
    "all": {
      "dependsOn": [
        "clean",
        "build",
        "format",
        "typecheck",
        "lint:fix",
        "markdown:lint",
        "test:ci",
        "test:cli"
      ]
    },
    "build": {
      "inputs": ["src/**"],
      "outputs": ["dist/**"],
      "dependsOn": ["clean", "^build"]
    },
    "test": {
      "inputs": ["test/**"]
    },
    "test:ci": {
      "dependsOn": ["_ni"]
    },
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "test:cli": {
      "dependsOn": ["build", "test:ci"]
    },
    "lint": {
      "cache": false,
      "dependsOn": ["format", "typecheck"]
    },
    "lint:fix": {
      "cache": false,
      "dependsOn": ["format", "typecheck"]
    },
    "markdown:lint": {
      "cache": false,
      "dependsOn": ["format"]
    },
    "clean": {
      "cache": false
    },
    "setup": {
      "cache": false
    },
    "format": {
      "cache": false
    },
    "test:watch": {},
    "typecheck": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
