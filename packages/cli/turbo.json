{
  "extends": ["//"],
  "pipeline": {
    "build": {
      "dependsOn": ["clean", "^build"],
      "inputs": ["src/**"],
      "outputs": ["dist/**"]
    },
    "test:cli": {
      "dependsOn": ["clean", "build"]
    },
    "test": {
      "dependsOn": ["test:cli"],
      "inputs": ["test/**"]
    },
    "clean": {},
    "dev": {},
    "typecheck": {}
  }
}
