{
  "extends": ["//"],
  "pipeline": {
    "build": {
      "dependsOn": ["clean", "^build"],
      "inputs": ["src/**"],
      "outputs": ["dist/**", "storybook-static/**"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["test/**"]
    },
    "storybook:preview": {
      "dependsOn": ["storybook:build", "wait-on-tcp"]
    },
    "storybook": {},
    "storybook:build": {},
    "wait-on-tcp": {},
    "clean": {},
    "typecheck": {}
  }
}
