{
  "name": "@gfft/ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": "./*"
  },
  "files": [
    "dist",
    "*.d.ts"
  ],
  "scripts": {
    "build": "tsup",
    "build:storybook": "storybook build",
    "dev:storybook": "storybook dev -p 6006",
    "preview:storybook": "nr build:storybook && vite preview --outDir storybook-static --host 0.0.0.0 --port 6006 --strictPort true",
    "serve:storybook": "vite preview --outDir storybook-static --host 0.0.0.0 --port 6006 --strictPort true",
    "test:storybook": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"nr serve:storybook\" \"npx wait-on tcp:127.0.0.1:6006 && test-storybook --url http://127.0.0.1:6006 --coverage\""
  },
  "dependencies": {
    "preact": "^10.29.3"
  },
  "devDependencies": {
    "@gfft/config": "workspace:^",
    "@storybook/addon-coverage": "^0.0.9",
    "@storybook/addon-essentials": "7.1.0",
    "@storybook/addon-interactions": "7.1.0",
    "@storybook/addon-links": "7.1.0",
    "@storybook/addon-storysource": "^7.6.24",
    "@storybook/blocks": "7.1.0",
    "@storybook/jest": "^0.2.3",
    "@storybook/preact": "^7.6.24",
    "@storybook/preact-vite": "^7.6.24",
    "@storybook/test-runner": "^0.13.0",
    "@storybook/testing-library": "^0.2.2",
    "concurrently": "^8.2.2",
    "nyc": "^18.0.0",
    "playwright": "^1.61.1",
    "storybook": "7.1.0",
    "vite": "^8.1.3",
    "wait-on": "^7.2.0"
  }
}
